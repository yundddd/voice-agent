+  // Loads kyutai's learned BOS-before-voice embedding from
+  // <encoder.onnx dir>/bos_before_voice.npy, the convention this build
+  // adds (no config-field growth, so the FFI structs stay compatible).
+  // The file ships inside the voice pack: for checkpoints that export it
+  // (english_2026-04+) GetVoiceEmbedding prepends it to the voice prompt;
+  // an absent file keeps the old behavior byte-for-byte.
+  void LoadBosBeforeVoice() {
+    const std::string &enc = config_.model.pocket.encoder;
+    auto pos = enc.rfind('/');
+    if (pos == std::string::npos) return;
+    std::string npy_path = enc.substr(0, pos + 1) + "bos_before_voice.npy";
+    if (!FileExists(npy_path)) return;
+
+    std::vector<char> data;
+    try {
+      data = ReadFile(npy_path);
+    } catch (...) {
+      return;
+    }
+    // NPY: '\x93NUMPY' magic, 1-byte version, header length (2-byte LE for
+    // v1, 4-byte LE for v2/v3), ASCII dict, then C-contiguous little-endian
+    // f4 payload. Only v1/v2 and descr '<f4' Fortran-order False are read.
+    if (data.size() < 80) return;
+    if (std::memcmp(data.data(), "\x93NUMPY", 6) != 0) return;
+    uint8_t major = static_cast<uint8_t>(data[6]);
+    size_t hdr_len = 0, off = 0;
+    if (major == 1) {
+      hdr_len = static_cast<size_t>(static_cast<uint8_t>(data[8])) |
+                (static_cast<size_t>(static_cast<uint8_t>(data[9])) << 8);
+      off = 10;
+    } else if (major == 2 || major == 3) {
+      hdr_len = static_cast<size_t>(static_cast<uint8_t>(data[8])) |
+                (static_cast<size_t>(static_cast<uint8_t>(data[9])) << 8) |
+                (static_cast<size_t>(static_cast<uint8_t>(data[10])) << 16) |
+                (static_cast<size_t>(static_cast<uint8_t>(data[11])) << 24);
+      off = 12;
+    } else {
+      return;
+    }
+    std::string header(data.data() + off, hdr_len);
+    if (header.find("'descr': '<f4'") == std::string::npos) return;
+    if (header.find("'fortran_order': False") == std::string::npos) return;
+    if (header.find("(1, 1, 1024)") == std::string::npos) return;
+    if (data.size() < off + hdr_len + 4 * 1024) return;
+
+    bos_before_voice_.resize(1024);
+    std::memcpy(bos_before_voice_.data(), data.data() + off + hdr_len,
+                4 * 1024);
+    bos_dim_ = 1024;
+    if (config_.model.debug) {
+      SHERPA_ONNX_LOGE("pocket: loaded bos_before_voice (1,1,1024) from %s",
+                       npy_path.c_str());
+    }
+  }
